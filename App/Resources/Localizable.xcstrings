    "Trust Uncoil's own scan for these folders." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu klasörler için Uncoil'in kendi taramasına güven."
          }
        }
      }
    },
    "Trust Uncoil's own scan for these servers." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucular için Uncoil'in kendi taramasına güven."
          }
        }
      }
    },
    "Try again" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden dene"
          }
        }
      }
    },
    "Turn done" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tur tamamlandı"
          }
        }
      }
    },
    "Turn done · %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tur tamamlandı · %@"
          }
        }
      }
    },
    "Turn off multiple selection" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoklu seçimi kapat"
          }
        }
      }
    },
    "Turns off the status colour; the icon takes the menu bar's own." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum rengini kapatır; simge menü çubuğunun kendi rengini alır."
          }
        }
      }
    },
    "Two optional programs that let an agent reach past its terminal. Uncoil probes and reports; nothing is ever installed without you asking for it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanın terminalin dışına erişmesini sağlayan iki isteğe bağlı program. Uncoil yalnızca kontrol edip durumu bildirir; istemediğiniz sürece hiçbir şey kurulmaz."
          }
        }
      }
    },
    "Type ? and your question" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "? yazıp sorunu sor"
          }
        }
      }
    },
    "typed in the agent's terminal" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ajanın terminaline yazıldı"
          }
        }
      }
    },
    "Types its prompt in and waits for you to send it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talimatı yazar ve göndermenizi bekler."
          }
        }
      }
    },
    "Unassigned" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atanmamış"
          }
        }
      }
    },
    "unavailable" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kullanılamıyor"
          }
        }
      }
    },
    "unchanged" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "değişmedi"
          }
        }
      }
    },
    "Unclassified finding" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınıflandırılmamış bulgu"
          }
        }
      }
    },
    "Uncoil" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil"
          }
        }
      }
    },
    "Uncoil adds its own entries to ~/.claude/settings.json and nothing else: a timestamped backup is written first, your own hooks are preserved byte for byte, and the file is re-parsed before it is saved." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil yalnızca ~/.claude/settings.json dosyasına kendi kayıtlarını ekler. Önce zaman damgalı yedek alır, mevcut hook'ları aynen korur ve kaydetmeden önce dosyayı yeniden ayrıştırır."
          }
        }
      }
    },
    "Uncoil already has a host with this alias." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil'de bu takma ada sahip bir sunucu zaten var."
          }
        }
      }
    },
    "Uncoil Auto" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil Auto"
          }
        }
      }
    },
    "Uncoil Auto is directing this agent" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil Auto bu ajanı yönlendiriyor"
          }
        }
      }
    },
    "Uncoil Auto Settings…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil Auto Ayarları…"
          }
        }
      }
    },
    "Uncoil can look for the dev server, build or compose stack this project already has, and put it behind one button." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil projedeki mevcut geliştirme sunucusunu, derlemeyi veya compose kurulumunu bulup tek düğmeyle çalıştırılabilir hale getirebilir."
          }
        }
      }
    },
    "Uncoil can look for the project's own test setup — a scheme, a Package.swift, go.mod, Cargo.toml, a package.json test script, or a pytest configuration. What it finds is written to .uncoil/tests.json, which you and your agents can edit." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil projenin test kurulumunu arayabilir: Xcode şeması, Package.swift, go.mod, Cargo.toml, package.json test komutu veya pytest yapılandırması. Buldukları, sizin ve ajanların düzenleyebileceği .uncoil/tests.json dosyasına yazılır."
          }
        }
      }
    },
    "Uncoil can look for the test setup this project already has, run it, and show what failed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil projenin mevcut test kurulumunu bulabilir, çalıştırabilir ve hataları gösterebilir."
          }
        }
      }
    },
    "Uncoil cannot ask %@ for a handover." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil, %@ ajanından devir bilgisi isteyemiyor."
          }
        }
      }
    },
    "Uncoil cannot tell how this was installed, so it will not guess at an update command." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bunun nasıl kurulduğunu belirleyemediği için güncelleme komutu tahmin etmez."
          }
        }
      }
    },
    "Uncoil changes these files only through plan → apply." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bu dosyaları yalnızca plan → apply ile değiştirir."
          }
        }
      }
    },
    "Uncoil data" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil verisi"
          }
        }
      }
    },
    "Uncoil detects these but does not manage their configuration; each moves up once an adapter for its config format lands." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bunları algılar ancak yapılandırmalarını yönetmez; ilgili bağdaştırıcı eklendiğinde bağlantıları geliştirilebilir."
          }
        }
      }
    },
    "Uncoil directory" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil dizini"
          }
        }
      }
    },
    "Uncoil Extensions" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil Uzantıları"
          }
        }
      }
    },
    "Uncoil follows this Mac's appearance, and switches with it. Changing appearance restores that theme's own colours, so any colours you have set below are replaced." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bu Mac'in görünümünü izler ve onunla değişir. Görünümü değiştirmek temanın kendi renklerini geri yükler; aşağıda seçtiğiniz renkler değiştirilir."
          }
        }
      }
    },
    "Uncoil hands every session an MCP server of its own, so the agent can talk back: eight tools, each one gated by a capability you control." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil her oturuma kendi MCP sunucusunu verir. Araçların her biri denetlediğiniz bir yetenekle sınırlandırılır."
          }
        }
      }
    },
    "Uncoil has no way to read usage for %@." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil, %@ kullanımını okuyamıyor."
          }
        }
      }
    },
    "Uncoil has not read usage for this account yet." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bu hesabın kullanımını henüz okumadı."
          }
        }
      }
    },
    "Uncoil in the foreground" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil ön planda"
          }
        }
      }
    },
    "Uncoil keeps one store for the extensions your agents use, and scans everything before it goes in." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil ajanların uzantıları için tek depo tutar ve eklenen her şeyi önce tarar."
          }
        }
      }
    },
    "Uncoil lock file" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil lock dosyası"
          }
        }
      }
    },
    "Uncoil looks at the GitHub remote of this folder and of the repositories one level inside it. A private repository needs a token — sign in from Settings › Uncoil › GitHub." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bu klasörün ve bir alt düzeyindeki depoların GitHub remote'larını inceler. Özel depolar için token gerekir; Ayarlar › Entegrasyonlar › GitHub üzerinden giriş yapın."
          }
        }
      }
    },
    "Uncoil mark" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil logosu"
          }
        }
      }
    },
    "Uncoil MCP" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil MCP"
          }
        }
      }
    },
    "Uncoil never raises a session above the mode you pick here — a child agent inherits its parent's, intersected, and cannot escalate." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil bir oturumu burada seçtiğin modun üstüne çıkarmaz — alt ajan, ebeveyninin modunu kesişimle devralır ve yetkisini yükseltemez."
          }
        }
      }
    },
    "Uncoil puts “Include uncoil_config” at the top of your SSH config, so ssh can find the hosts you add here. Nothing else in the file changes, and the current file is copied to ~/.ssh/config.bak first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil, burada eklediğiniz sunucuları ssh bulabilsin diye SSH yapılandırmanızın başına “Include uncoil_config” ekler. Diğer satırlar değişmez; önce mevcut dosya ~/.ssh/config.bak konumuna kopyalanır."
          }
        }
      }
    },
    "Uncoil quit while the run was going." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma sürerken Uncoil kapandı."
          }
        }
      }
    },
    "Uncoil reads the login each CLI already carries. None are signed in yet — the provider's own flow opens in a small terminal, and the credentials stay with the CLI." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil her CLI'ın mevcut girişini okur. Henüz hiçbirinde giriş yapılmamış; sağlayıcının giriş akışı küçük bir terminalde açılır ve giriş bilgileri CLI'da kalır."
          }
        }
      }
    },
    "Uncoil reads the task files already in your project and turns them into a board you can hand out from. The file stays yours — only the line that changed is patched, never the whole file." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil projedeki mevcut görev dosyalarını dağıtabileceğiniz bir panoya dönüştürür. Dosya sizin kalır; tüm dosya yerine yalnızca ilgili satır değiştirilir."
          }
        }
      }
    },
    "Uncoil runs the CLIs already on your Mac. Nothing is installed for you." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil Mac'inizde kurulu CLI'ları çalıştırır. Kendiliğinden hiçbir şey kurulmaz."
          }
        }
      }
    },
    "Uncoil settings" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil ayarları"
          }
        }
      }
    },
    "Uncoil Settings" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil Ayarları"
          }
        }
      }
    },
    "Uncoil version" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil sürümü"
          }
        }
      }
    },
    "uncoil_browser — driven by the optional agent-browser driver over a Playwright-managed Chromium, in a blank profile with no access to your own logins. Installing that driver always asks you first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_browser — isteğe bağlı agent-browser sürücüsüyle, kişisel girişlerinize erişmeyen boş bir Chromium profili kullanır. Sürücü kurulumu her zaman onayınızı gerektirir."
          }
        }
      }
    },
    "uncoil_computer — sees this Mac's screen and drives its mouse and keyboard through the optional cua-driver, which also needs macOS's Screen Recording and Accessibility permissions. Off until you turn it on." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_computer — isteğe bağlı cua-driver ile bu Mac'in ekranını görür, fareyi ve klavyeyi kullanır. macOS Ekran Kaydı ve Erişilebilirlik izinleri de gerekir. Siz açana kadar kapalıdır."
          }
        }
      }
    },
    "uncoil_projects · uncoil_artifacts — the agent reads your projects, cuts a worktree for itself, and leaves files behind that you can open." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_projects · uncoil_artifacts — ajan projeleri okur, kendisine worktree oluşturur ve açabileceğiniz dosyalar bırakır."
          }
        }
      }
    },
    "uncoil_projects · uncoil_sessions · uncoil_artifacts · uncoil_tasks" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_projects · uncoil_sessions · uncoil_artifacts · uncoil_tasks"
          }
        }
      }
    },
    "uncoil_run — detects how the project starts, edits that configuration and launches it, so the agent can verify its own change." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_run — projenin nasıl başlatıldığını algılar, yapılandırmasını düzenler ve çalıştırır; ajan böylece kendi değişikliğini doğrulayabilir."
          }
        }
      }
    },
    "uncoil_run · uncoil_system · uncoil_browser · uncoil_computer" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_run · uncoil_system · uncoil_browser · uncoil_computer"
          }
        }
      }
    },
    "uncoil_sessions — the agent sees the other sessions in its project and can start a child agent. No raw shell is ever accepted: children come from named presets only." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_sessions — ajan projedeki diğer oturumları görür ve alt ajan başlatabilir. Ham shell komutu kabul edilmez; alt ajanlar yalnızca adlandırılmış önayarlardan oluşturulur."
          }
        }
      }
    },
    "uncoil_tasks — the agent reads your TODO.md and ticks off what it finished. The file stays yours: only the relevant line is patched." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil_tasks — ajan TODO.md dosyanızı okur ve tamamladığı görevleri işaretler. Dosya sizin kalır; yalnızca ilgili satır değiştirilir."
          }
        }
      }
    },
    "uncoil-mcp is missing from the app bundle. Sessions will start, and the uncoil tools will not be there." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil-mcp uygulama paketinde yok. Oturumlar açılır ama uncoil araçları orada olmaz."
          }
        }
      }
    },
    "uncoil-runtimed is unreachable; sessions run on the in-app PTY." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uncoil-runtimed erişilemiyor; oturumlar uygulama içi PTY ile çalışıyor."
