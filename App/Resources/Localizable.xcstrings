          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme komutu başarılı oldu ancak %@ hâlâ %@. Büyük olasılıkla başka bir Node kurulumuna yüklendi; yukarıdaki komut kullanılan npm konumunu gösterir."
          }
        }
      }
    },
    "The update ran, but the version could not be read afterwards." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme çalıştı ancak sonrasında sürüm okunamadı."
          }
        }
      }
    },
    "The update removed a tool: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update tool kaldırdı: %@"
          }
        }
      }
    },
    "The Worker could not start: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worker başlatılamadı: %@"
          }
        }
      }
    },
    "The working tree moved to branch %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma ağacı %@ dalına geçti."
          }
        }
      }
    },
    "The worktree could not be created: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktree oluşturulamadı: %@"
          }
        }
      }
    },
    "The Xcode scheme in the command doesn't exist. Run `xcodebuild -list` in %@ and fix the -scheme argument in .uncoil/run.json." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
