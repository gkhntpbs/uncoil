    },
    "You can keep Uncoil in the menu bar, quit using each run's setting, or stop all project processes before quitting. Agent sessions follow your separate quit setting." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uncoil’i menü çubuğunda açık tutabilir, her çalıştırmanın ayarına göre çıkabilir veya çıkmadan önce tüm proje işlemlerini durdurabilirsiniz. Ajan oturumları ayrı çıkış ayarınıza uyar."
          }
        }
      }
    },
