      }
    },
    "When a specialist fails" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzman başarısız olduğunda"
          }
        }
      }
    },
    "When busy" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoğunken"
          }
        }
      }
    },
    "When needed" : {
