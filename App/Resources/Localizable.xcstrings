        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerektiğinde"
          }
        }
      }
    },
    "When needed: the research gate decides, deterministically or with Laya." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerektiğinde: kararı kurallar veya Laya verir."
          }
        }
      }
    },
    "When should the agent use this?" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent bunu ne zaman kullanmalı?"
          }
        }
